# STLEDS Environment Configuration
# All variables are optional and have built-in defaults for immediate local execution.

# Server Port (default: 3000)
PORT=3000

# Server Host (default: 0.0.0.0)
HOST=0.0.0.0

# Secret key used for signing and verifying JSON Web Tokens
JWT_SECRET=stleds-super-secret-jwt-key-2026

# Node Environment: 'development' or 'production'
NODE_ENV=development

# Optional: Remote backend API URL for frontend (leave empty for same-origin relative URLs)
VITE_API_URL=
